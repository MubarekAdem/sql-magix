{
  "name": "@sql-magic/server",
  "version": "0.1.0",
  "description": "Lightweight Hono backend server and SSE live watcher for sql-magic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MubarekAdem/sql-magix.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@sql-magic/core": "workspace:*",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
