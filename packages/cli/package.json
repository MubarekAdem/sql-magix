{
  "name": "sql-magic",
  "version": "0.1.0",
  "description": "High-performance, dialect-neutral database viewer and query studio for SQLite, PostgreSQL, and MySQL",
  "type": "module",
  "bin": {
    "sql-magic": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "sql",
    "database",
    "sqlite",
    "postgres",
    "postgresql",
    "mysql",
    "database-viewer",
    "gui",
    "query-studio",
    "er-diagram"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MubarekAdem/sql-magix.git"
  },
  "scripts": {
    "build": "tsc -b && node copy-ui.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sql-magic/core": "workspace:*",
    "@sql-magic/server": "workspace:*",
    "commander": "^13.1.0",
    "dotenv": "^18.0.9",
    "open": "^11.0.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
